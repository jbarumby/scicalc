set_option maxHeartbeats 3000000 in
theorem center_id8 (i j : Fin 8) :
    center8 i j = Numeria.ES8P13.matrix8 i j +
        (if i = j then (3 : ℚ) / 50 else 0) := by
  fin_cases i <;> fin_cases j <;> norm_num [center8, Numeria.ES8P13.matrix8]

set_option maxHeartbeats 4000000 in
theorem raw_box8 : ∀ i j : Fin 8,
    -error8 i j ≤ lower8 i j - center8 i j ∧
      upper8 i j - center8 i j ≤ error8 i j := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [lower8, upper8, center8, error8]

theorem error_symmetric8 : ∀ i j : Fin 8, error8 i j = error8 j i := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [error8]

set_option maxHeartbeats 3000000 in
theorem error_rows8 : ∀ i : Fin 8,
    (∑ j : Fin 8, error8 i j) ≤ (1 : ℚ) / 100 := by
  intro i
  fin_cases i <;> norm_num [error8, Fin.sum_univ_succ]

/-- Rational matrix with entries in the original interval boxes is positive
    with margin 1/20, CONDITIONAL on the source intervals being analytic enclosures. -/
theorem box_positive8 (M : Fin 8 → Fin 8 → ℚ)
    (hbox : ∀ i j : Fin 8, lower8 i j ≤ M i j ∧ M i j ≤ upper8 i j)
    (x : Fin 8 → ℚ) (hx : ∃ i, x i ≠ 0) :
    (1 : ℚ) / 20 * (∑ i : Fin 8, x i ^ 2) < Numeria.ES8P14.qForm M x := by
  have hentry : ∀ i j : Fin 8,
      -error8 i j ≤ M i j - center8 i j ∧
       M i j - center8 i j ≤ error8 i j := by
    intro i j
    have hr := raw_box8 i j
    have hb := hbox i j
    constructor <;> linarith
  have hcoarse :
      0 < Numeria.ES8P14.qForm
         (fun i j => center8 i j - if i = j then (3 : ℚ) / 50 else 0) x := by
    have heq : (fun i j => center8 i j - if i = j then (3 : ℚ) / 50 else 0) =
        Numeria.ES8P13.matrix8 := by
      funext i j
      rw [center_id8 i j]
      split_ifs <;> ring
    rw [heq]
    exact Numeria.ES8P13.concrete_positive8 x hx
  exact Numeria.ES8P14.positive_from_LDL_and_box M center8 error8 x
    hcoarse error_symmetric8 hentry error_rows8


