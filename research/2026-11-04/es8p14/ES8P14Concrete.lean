set_option maxHeartbeats 3000000 in
theorem center_id4 (i j : Fin 4) :
    center4 i j = Numeria.ES8P13.matrix4 i j +
        (if i = j then (3 : ℚ) / 50 else 0) := by
  fin_cases i <;> fin_cases j <;> norm_num [center4, Numeria.ES8P13.matrix4]

set_option maxHeartbeats 4000000 in
theorem raw_box4 : ∀ i j : Fin 4,
    -error4 i j ≤ lower4 i j - center4 i j ∧
      upper4 i j - center4 i j ≤ error4 i j := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [lower4, upper4, center4, error4]

theorem error_symmetric4 : ∀ i j : Fin 4, error4 i j = error4 j i := by
  intro i j
  fin_cases i <;> fin_cases j <;> norm_num [error4]

set_option maxHeartbeats 3000000 in
theorem error_rows4 : ∀ i : Fin 4,
    (∑ j : Fin 4, error4 i j) ≤ (1 : ℚ) / 100 := by
  intro i
  fin_cases i <;> norm_num [error4, Fin.sum_univ_succ]

/-- Rational matrix with entries in the original interval boxes is positive
    with margin 1/20, CONDITIONAL on the source intervals being analytic enclosures. -/
theorem box_positive4 (M : Fin 4 → Fin 4 → ℚ)
    (hbox : ∀ i j : Fin 4, lower4 i j ≤ M i j ∧ M i j ≤ upper4 i j)
    (x : Fin 4 → ℚ) (hx : ∃ i, x i ≠ 0) :
    (1 : ℚ) / 20 * (∑ i : Fin 4, x i ^ 2) < Numeria.ES8P14.qForm M x := by
  have hentry : ∀ i j : Fin 4,
      -error4 i j ≤ M i j - center4 i j ∧
       M i j - center4 i j ≤ error4 i j := by
    intro i j
    have hr := raw_box4 i j
    have hb := hbox i j
    constructor <;> linarith
  have hcoarse :
      0 < Numeria.ES8P14.qForm
         (fun i j => center4 i j - if i = j then (3 : ℚ) / 50 else 0) x := by
    have heq : (fun i j => center4 i j - if i = j then (3 : ℚ) / 50 else 0) =
        Numeria.ES8P13.matrix4 := by
      funext i j
      rw [center_id4 i j]
      split_ifs <;> ring
    rw [heq]
    exact Numeria.ES8P13.concrete_positive4 x hx
  exact Numeria.ES8P14.positive_from_LDL_and_box M center4 error4 x
    hcoarse error_symmetric4 hentry error_rows4


